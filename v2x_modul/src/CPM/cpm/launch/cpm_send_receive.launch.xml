<!--
  CPM sender + receiver egy launch-bol.

  Ket kulon cpm_node indul:
    - v2x_sender:   is_sender=true  -> CPM-et kuld ES fogad
    - v2x_receiver: is_sender=false -> csak fogad

  FIGYELEM: mindket node ugyanazt a halozati interfeszt nyitja meg raw socketen,
  igy sajat magat is hallja. Ha egy gepen csak egy stack kell, hasznald a
  cpm.launch.xml-t (az egy node onmagaban is kuld es fogad).
-->
<launch>
  <arg name="network_interface" default="wlp5s0"/>
  <arg name="sender_namespace" default="v2x_sender"/>
  <arg name="receiver_namespace" default="v2x_receiver"/>

  <!-- Sender: kuld es fogad -->
  <node pkg="cpm" exec="cpm_node" name="cpm_sender"
        namespace="$(var sender_namespace)" output="screen">
    <param name="network_interface" value="$(var network_interface)"/>
    <param name="is_sender" value="true"/>
  </node>

  <!-- Receiver: csak fogad -->
  <node pkg="cpm" exec="cpm_node" name="cpm_receiver"
        namespace="$(var receiver_namespace)" output="screen">
    <param name="network_interface" value="$(var network_interface)"/>
    <param name="is_sender" value="false"/>
  </node>
</launch>
